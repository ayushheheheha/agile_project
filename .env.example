# =============================================================================
# HireSignal — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

# Your Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — safe to expose to the browser
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — KEEP SECRET, backend only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get your free API key at: https://ai.google.dev/
# Free tier: gemini-1.5-flash model, rate limits apply
# The app falls back to local keyword scoring if this is missing or rate-limited.
GEMINI_API_KEY=your-gemini-api-key

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# URL of the frontend (for CORS — only needed in production)
FRONTEND_URL=http://localhost:80

# ── Frontend (Vite env vars — must be prefixed with VITE_) ────────────────────
# These are baked in at build time by Vite. For Docker, they are passed as
# build args (see docker-compose.yml). For local dev, create frontend/.env
# with these values (same SUPABASE_URL and SUPABASE_ANON_KEY from above).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL.
# - In development with Vite dev server: leave empty or /api (proxy handles it)
# - In production Docker: /api (nginx proxy handles it)
VITE_API_URL=/api
